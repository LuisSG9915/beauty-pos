{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-pos",
  "main": ".open-next/worker.js",
  // Dominio canónico de Melena. `workers.dev` se mantiene activo durante la
  // migración como ruta de verificación/rollback.
  "workers_dev": true,
  "routes": [
    { "pattern": "melena.app", "custom_domain": true },
    { "pattern": "www.melena.app", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Pooling de conexiones a PostgreSQL (CockroachDB us-east-2): reduce la
  // latencia por consulta del Worker. `src/db/client.ts` prefiere este binding
  // y cae a DATABASE_URL solo en desarrollo local.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1e6092cc079c4f5c86a5d4bca6ddc7e4"
    }
  ],
  "upload_source_maps": true
}
