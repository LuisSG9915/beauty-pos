{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-pos",
  // Entry point propio: envuelve el worker generado por OpenNext para añadir
  // el handler `scheduled` del cron de recordatorios (ver custom-worker.ts).
  "main": "custom-worker.ts",
  // Dominio canónico de Melena. `workers.dev` se mantiene activo durante la
  // migración como ruta de verificación/rollback.
  "workers_dev": true,
  "routes": [
    { "pattern": "melena.app", "custom_domain": true },
    { "pattern": "www.melena.app", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // El Worker hace varias consultas por request a CockroachDB (aws-us-east-2).
  // Correr junto a la BD convierte cada ronda DFW→Ohio (~80 ms) en ~3 ms; el
  // usuario solo paga una ida extra. Revertir quitando esta clave + deploy.
  "placement": {
    "region": "aws:us-east-2"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  // Pooling de conexiones a PostgreSQL (CockroachDB us-east-2): reduce la
  // latencia por consulta del Worker. `src/db/client.ts` prefiere este binding
  // y cae a DATABASE_URL solo en desarrollo local.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1e6092cc079c4f5c86a5d4bca6ddc7e4"
    }
  ],
  // Caché de datos fríos (suscripción vigente, catálogo de planes) para
  // ahorrar rondas a CockroachDB en cada navegación. `src/lib/kv-cache.ts`
  // degrada a miss cuando el binding no existe (desarrollo local).
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "0fd2b9c97f8e4819b2c4b9f15e87cb81"
    }
  ],
  // Imágenes de catálogo y fichas (plan 07): `src/lib/media.ts` degrada a
  // "sin imagen" cuando el binding no existe (desarrollo local sin wrangler).
  // El bucket se crea manualmente: `npx wrangler r2 bucket create melena-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "melena-media"
    }
  ],
  // Workers AI para la captura de productos desde foto (plan 08):
  // `src/lib/ia/cliente.ts` degrada a "no disponible" cuando el binding no
  // existe (desarrollo local con `pnpm dev`, sin wrangler).
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY_AE",
      "dataset": "melena_telemetry"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // AI Gateway `melena-ia` se crea a mano en el dashboard (ver "Pasos
  // manuales" del plan 08). Descomentar la var SOLO cuando el gateway exista:
  // si se apunta a un id inexistente, todas las llamadas a AI.run fallan.
  // Sin la var, las llamadas van directas al binding (path válido).
  // "vars": { "AI_GATEWAY_ID": "melena-ia" },
  "upload_source_maps": true
}
